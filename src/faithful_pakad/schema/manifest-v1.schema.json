{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faithful-oversight.github.io/faithful-pakad/schema/manifest-v1.schema.json",
  "title": "pakad run manifest",
  "description": "Version 1 of the manifest pakad writes with every run. It lists each report file from the run with its size and SHA-256, so a reader can confirm that a set of files is complete, unchanged, and from one run, including a findings CSV with no rows. `pakad schema manifest` prints this schema offline. The same compatibility rules as the report schema apply.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "tool", "run_id", "generated_at", "files"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "pakad"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "The run ID that every report from this run also records."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "Every other file pakad wrote in this run, in the order it placed them. The manifest is placed last.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "bytes", "sha256"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^pakad-[a-z]+\\.[a-z]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
